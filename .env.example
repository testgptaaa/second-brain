# Second Brain Configuration Example

# ─── LLM Model Gateway (OpenAI-compatible or api.sd1.su) ───────────────────
LLM_BASE_URL=https://api.sd1.su/v1
LLM_API_KEY=your_llm_api_key_here
LLM_TEXT_MODEL=gpt-5.6-luna
LLM_VISION_MODEL=gemini-3-flash
LLM_MODEL_NAME=gpt-5.6-luna

# ─── NeuralDeep Service ───────────────────────────────────────────────────
NEURALDEEP_ENDPOINT=https://api.neuraldeep.ru/v1
NEURALDEEP_API_KEY=your_neuraldeep_api_key_here
NEURALDEEP_CHAT_MODEL=qwen3.6-35b-a3b
NEURALDEEP_EMBEDDING_MODEL=bge-m3
NEURALDEEP_RERANK_MODEL=bge-reranker

# ─── Screenshot Observation & Retention ─────────────────────────────────────
# Interval in seconds between background captures (default: 15s)
CAPTURE_INTERVAL_SECONDS=15

# Maximum age of temporary screenshots before auto-cleanup (in days)
CAPTURE_MAX_AGE_DAYS=7

# Maximum storage limit for temporary screenshots in MB
CAPTURE_MAX_STORAGE_MB=2000
